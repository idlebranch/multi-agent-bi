# Copy this file to .env. Never commit real passwords or API keys.

# Required for LLM-backed Agent requests.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# PostgreSQL 17 infrastructure and local Compose settings.
BI_POSTGRES_DB=multi_agent_bi
BI_POSTGRES_OWNER=bi_owner
BI_POSTGRES_OWNER_PASSWORD=replace-with-a-long-random-owner-password
BI_POSTGRES_READONLY_PASSWORD=replace-with-a-long-random-readonly-password
BI_POSTGRES_PORT=5432

# Owner connection is only for schema/data loading. The Agent must use agent_readonly.
BI_MIGRATION_DATABASE_URL=postgresql://bi_owner:owner-password@127.0.0.1:5432/multi_agent_bi
BI_DATABASE_URL=postgresql://agent_readonly:readonly-password@127.0.0.1:5432/multi_agent_bi
BI_TEST_DATABASE_URL=postgresql://agent_readonly:readonly-password@127.0.0.1:5432/multi_agent_bi

# Optional data/runtime settings
# BI_DATA_AS_OF_DATE=2018-10-17
# BI_SEMANTIC_MODEL=D:/path/to/semantic_model.json
BI_MAX_ITERATIONS=12
BI_MAX_ALLOWED_ITERATIONS=12
BI_MAX_RESULT_ROWS=200
BI_SQL_TIMEOUT_SECONDS=5
BI_DB_MAX_CONCURRENCY=4
BI_DB_QUEUE_TIMEOUT_SECONDS=10
BI_SCHEMA_MAX_TABLES=200
BI_SCHEMA_DETAIL_MAX_TABLES=20
BI_LLM_TIMEOUT_SECONDS=60
BI_LLM_MAX_RETRIES=2
BI_TRUST_ENV_PROXY=false
