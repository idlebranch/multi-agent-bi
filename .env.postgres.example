# Copy to a local ignored environment file; do not commit real passwords.
BI_POSTGRES_DB=multi_agent_bi
BI_POSTGRES_OWNER=bi_owner
BI_POSTGRES_OWNER_PASSWORD=replace-with-a-long-random-owner-password
BI_POSTGRES_READONLY_PASSWORD=replace-with-a-long-random-readonly-password
BI_POSTGRES_PORT=5432

# ETL/schema connection (owner only; never use from the Agent).
BI_MIGRATION_DATABASE_URL=postgresql://bi_owner:owner-password@127.0.0.1:5432/multi_agent_bi

# Production Agent connection.
BI_DATABASE_URL=postgresql://agent_readonly:readonly-password@127.0.0.1:5432/multi_agent_bi
